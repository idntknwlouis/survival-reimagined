		"main": [
			"net.idntknwlouis.survivalreimaginedfabric.SurvivalReimaginedFabric"
		],
		"fabric-datagen": [
			"net.idntknwlouis.survivalreimaginedfabric.SurvivalReimaginedFabricDataGenerator"
		],
		"client": [
			"net.idntknwlouis.survivalreimaginedfabric.SurvivalReimaginedFabricClient"
		]
	},
	"mixins": [
		"survival-reimagined-fabric.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
