{
	"schemaVersion": 1,
	"id": "survival-reimagined-fabric",
	"version": "${version}",
	"name": "Survival Reimagined (Fabric)",
	"description": "A Minecraft Mod with the goal of making Minecraft harder with a more realistic approach at progression",
	"authors": [
		"ShotUGMG, idntknwlouis"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/survival-reimagined",
		"sources": "https://github.com/idntknwlouis/survival-reimagined-fabric-1.21.x",
		"issues": "https://github.com/idntknwlouis/survival-reimagined-fabric-1.21.x/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/survival-reimagined-fabric/textures/heart-fabric.png",
